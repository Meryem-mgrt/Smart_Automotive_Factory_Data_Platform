# =====================================================================
# .env.example : modèle des variables d'environnement (valeurs de DÉVELOPPEMENT)
# Copier en .env :  cp .env.example .env   puis changer les mots de passe.
# Le vrai fichier .env est ignoré par git (voir .gitignore) : ne jamais le versionner.
# =====================================================================

# --- PostgreSQL (entrepôt de données de l'usine) ---
POSTGRES_USER=factory                 # super-utilisateur : écrit dans raw, DBT construit staging/marts
POSTGRES_PASSWORD=change_me_pg        # mot de passe du super-utilisateur (à changer)
POSTGRES_DB=factory_dw                # base de l'usine, créée au premier démarrage
READONLY_PASSWORD=change_me_ro        # mot de passe du compte lecture seule bi_reader (Power BI, chatbot)

# --- Airflow ---
AIRFLOW_DB=airflow                    # base des métadonnées d'Airflow (séparée de factory_dw)
AIRFLOW_UID=50000                     # sur Linux : remplacer par le résultat de la commande `id -u`
AIRFLOW_ADMIN_USER=admin              # compte administrateur de l'interface Airflow
AIRFLOW_ADMIN_PASSWORD=change_me_af   # mot de passe de l'administrateur (à changer)
AIRFLOW_SECRET_KEY=change_me_secret   # clé de session du webserver (à changer)

# --- MQTT (Mosquitto) ---
MQTT_HOST=mosquitto                   # nom du service Docker du broker
MQTT_PORT=1883                        # port MQTT standard
MQTT_TOPIC_ROOT=usine                 # racine des topics : usine/{ligne}/{machine}/{type}

# --- Simulateur (utilisé en Phase 2) ---
SIM_INTERVAL_SECONDS=5                # période de la télémétrie en secondes
SIM_ANOMALY_RATE=0.02                 # probabilité d'injecter une anomalie par machine et par cycle
